DEBUG=true
SECRET_KEY=change-me
ESPN_SEASON=2026
# Encrypts saved ESPN logins: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# To rotate, put the new key first and keep the old one after a comma until everything is re-saved.
CREDENTIAL_KEY=
# Optional: enables "Explain" buttons (console.anthropic.com)
ANTHROPIC_API_KEY=
# Only if your key isn't scoped to a workspace (sk-ant-usr-...): Console → Settings → Workspaces
ANTHROPIC_WORKSPACE_ID=
# Model for explanations; Haiku is cheapest (~$0.0003/click)
CLAUDE_MODEL=claude-haiku-5-5
